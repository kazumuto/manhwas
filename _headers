# Cloudflare Pages headers — mirrors vercel.json (both stacks deploy the
# same dist/; Vercel ignores this file, Pages uses it).
/assets/*
  Cache-Control: public, max-age=31536000, immutable
# Chapter-bearing JSON gets SHORT edge caches (2026-09-16): these carry the
# chapter counts and latest-chapter numbers users see. The old 6h edge TTL
# (s-maxage=21600) meant a freshly-uploaded snapshot could take 6+ hours to
# reach visitors — the "I don't see today's chapters" report. With 30 min
# edge / 5 min browser, a new snapshot is visible within minutes of the
# 2-hourly refresh; stale-while-revalidate keeps responses instant while
# the edge revalidates.
/catalog.json
  Cache-Control: public, max-age=300, s-maxage=1800, stale-while-revalidate=86400
/catalog-full.json
  Cache-Control: public, max-age=900, s-maxage=7200, stale-while-revalidate=86400
/catalog-mk-meta.json
  Cache-Control: public, max-age=300, s-maxage=1800, stale-while-revalidate=86400
/mk-chapters/*
  Cache-Control: public, max-age=600, s-maxage=3600, stale-while-revalidate=86400
# Prerendered hub/listing pages (2026-09-28 audit): they carried only
# max-age=14400 + must-revalidate, so nearly every request re-ran the origin
# render (cf-cache-status EXPIRED, 158–232 ms). The /read pages' s-maxage +
# SWR model serves them from edge while revalidating in the background —
# same freshness (catalog deploys invalidate), far fewer origin renders.
/manhwa
  Cache-Control: public, max-age=300, s-maxage=1800, stale-while-revalidate=86400
